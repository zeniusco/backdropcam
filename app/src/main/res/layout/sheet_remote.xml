<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="8dp"
        android:paddingEnd="24dp"
        android:paddingBottom="32dp">

        <TextView style="@style/SheetTitle" android:text="Second-screen remote" />

        <TextView
            style="@style/SheetLabel"
            android:layout_marginTop="0dp"
            android:text="Watch the camera and start, pause or stop recording from another phone, tablet or laptop. Nothing to install: just open the link in its browser." />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/remoteSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Allow remote viewing and control" />

        <ImageView
            android:id="@+id/remoteQr"
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:background="@android:color/white"
            android:contentDescription="QR code with the remote link"
            android:padding="8dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/remoteUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:textColor="@android:color/white"
            android:textIsSelectable="true"
            android:textSize="15sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/remoteShareBtn"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Share link"
            android:visibility="gone" />

        <TextView
            style="@style/SheetLabel"
            android:text="Both devices must be on the same Wi-Fi, or connect the other device to this phone's hotspot. The link contains a private key, so only people you give it to can connect." />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
