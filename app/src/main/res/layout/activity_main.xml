<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- Live composited preview. Its aspect ratio is set from code (FULL / 16:9 / 4:3). -->
    <SurfaceView
        android:id="@+id/surface"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="9:16"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Tap-to-focus ring, moved to the tap position from code -->
    <View
        android:id="@+id/focusRing"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:alpha="0"
        android:background="@drawable/focus_ring"
        android:importantForAccessibility="no"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Top bar: settings | quick toggles | torch -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_top_gradient"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/settingsBtn"
            style="@style/RoundIcon"
            android:contentDescription="Settings"
            android:src="@drawable/ic_settings" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/quickRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_dark"
            android:orientation="horizontal"
            android:padding="3dp">

            <TextView
                android:id="@+id/aspectChip"
                style="@style/QuickChip"
                android:contentDescription="Picture shape"
                android:text="FULL" />

            <TextView
                android:id="@+id/qualityChip"
                style="@style/QuickChip"
                android:contentDescription="Video quality"
                android:text="4K" />

            <TextView
                android:id="@+id/timerChip"
                style="@style/QuickChip"
                android:contentDescription="Countdown timer"
                android:drawableStart="@drawable/ic_timer_off"
                android:text="" />
        </LinearLayout>

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/flashBtn"
            style="@style/RoundIcon"
            android:contentDescription="Torch"
            android:src="@drawable/ic_flash_off" />
    </LinearLayout>

    <!-- Recording indicator: red dot, time, mic level -->
    <LinearLayout
        android:id="@+id/recPill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_pill_dark"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="7dp"
        android:paddingEnd="14dp"
        android:paddingBottom="7dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <View
            android:id="@+id/recDot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/dot_red" />

        <TextView
            android:id="@+id/recTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFeatureSettings="tnum"
            android:text="00:00"
            android:textColor="@android:color/white"
            android:textSize="15sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/levelBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="56dp"
            android:layout_height="4dp"
            android:layout_marginStart="12dp"
            android:max="100"
            android:progressBackgroundTint="#40FFFFFF"
            android:progressTint="#4CD964" />
    </LinearLayout>

    <!-- Teleprompter (front camera): just under the lens so your eyes stay on the camera -->
    <FrameLayout
        android:id="@+id/teleBox"
        android:layout_width="0dp"
        android:layout_height="220dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="10dp"
        android:background="@drawable/bg_card"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/recPill"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/sideRail">

        <ScrollView
            android:id="@+id/teleScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fadingEdgeLength="48dp"
            android:requiresFadingEdge="vertical"
            android:scrollbars="none">

            <TextView
                android:id="@+id/teleText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingMultiplier="1.2"
                android:paddingStart="20dp"
                android:paddingTop="56dp"
                android:paddingEnd="20dp"
                android:paddingBottom="220dp"
                android:textColor="@android:color/white"
                android:textSize="28sp"
                android:textStyle="bold" />
        </ScrollView>
    </FrameLayout>

    <!-- Floating side toolbar, top right under the top bar -->
    <LinearLayout
        android:id="@+id/sideRail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_rail"
        android:orientation="vertical"
        android:padding="6dp"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/micBtn"
            style="@style/RailIcon"
            android:contentDescription="Microphone"
            android:src="@drawable/ic_mic" />

        <ImageButton
            android:id="@+id/handsBtn"
            style="@style/RailIcon"
            android:layout_marginTop="4dp"
            android:contentDescription="Hands-free voice mode"
            android:src="@drawable/ic_record_voice_over" />

        <ImageButton
            android:id="@+id/tuneBtn"
            style="@style/RailIcon"
            android:layout_marginTop="4dp"
            android:contentDescription="Adjust size, brightness and warmth"
            android:src="@drawable/ic_tune" />

        <ImageButton
            android:id="@+id/teleBtn"
            style="@style/RailIcon"
            android:layout_marginTop="4dp"
            android:contentDescription="Teleprompter"
            android:src="@drawable/ic_notes" />
    </LinearLayout>

    <TextView
        android:id="@+id/countdownText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:shadowColor="#99000000"
        android:shadowRadius="16"
        android:textColor="@android:color/white"
        android:textSize="132sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Short on-screen messages (instead of system toasts) -->
    <TextView
        android:id="@+id/hintText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="12dp"
        android:alpha="0"
        android:background="@drawable/bg_hint"
        android:gravity="center"
        android:paddingStart="16dp"
        android:paddingTop="9dp"
        android:paddingEnd="16dp"
        android:paddingBottom="9dp"
        android:textColor="@android:color/white"
        android:textSize="14sp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/bottomArea"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Bottom: adjust panel, lens switch, backdrops, shutter row -->
    <LinearLayout
        android:id="@+id/bottomArea"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bottom_gradient"
        android:orientation="vertical"
        android:paddingTop="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/adjustPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="14dp"
            android:paddingEnd="18dp"
            android:paddingBottom="8dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Drag the picture to move yourself, pinch to resize"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView style="@style/AdjustLabel" android:text="Size" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/sizeAdjust"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:valueFrom="50"
                    android:valueTo="100" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView style="@style/AdjustLabel" android:text="Brightness" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/brightAdjust"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:valueFrom="-1"
                    android:valueTo="1" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView style="@style/AdjustLabel" android:text="Warmth" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/warmAdjust"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:valueFrom="-1"
                    android:valueTo="1" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/autoMatchBtn"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Auto match light" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/resetAdjustBtn"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Reset" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/doneAdjustBtn"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="Done" />
            </LinearLayout>
        </LinearLayout>

        <!-- Lens switch (0.6x / 1x); hidden when the camera has no wider lens -->
        <LinearLayout
            android:id="@+id/zoomRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_pill_dark"
            android:orientation="horizontal"
            android:padding="3dp"
            android:visibility="gone" />

        <HorizontalScrollView
            android:id="@+id/stripScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:clipToPadding="false"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/backdropStrip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="104dp"
            android:layout_marginTop="6dp">

            <ImageView
                android:id="@+id/lastThumb"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="40dp"
                android:background="@drawable/bg_thumb"
                android:contentDescription="Last video"
                android:padding="2dp"
                android:scaleType="centerCrop" />

            <FrameLayout
                android:id="@+id/recordBtn"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_gravity="center"
                android:background="@drawable/shutter_ring"
                android:contentDescription="Record">

                <View
                    android:id="@+id/recordInner"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_gravity="center"
                    android:background="@drawable/shutter_idle" />
            </FrameLayout>

            <ImageButton
                android:id="@+id/pauseBtn"
                style="@style/RoundIcon"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="40dp"
                android:padding="13dp"
                android:contentDescription="Pause or resume"
                android:src="@drawable/ic_pause"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/flipBtn"
                style="@style/RoundIcon"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="40dp"
                android:padding="13dp"
                android:contentDescription="Switch camera"
                android:src="@drawable/ic_flip_camera_android" />
        </FrameLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
