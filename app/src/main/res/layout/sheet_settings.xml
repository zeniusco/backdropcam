<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="8dp"
        android:paddingEnd="24dp"
        android:paddingBottom="32dp">

        <TextView style="@style/SheetTitle" android:text="Settings" />

        <!-- Recording -->
        <TextView style="@style/SheetSection" android:text="Recording" />

        <TextView style="@style/SheetLabel" android:text="Stop automatically after" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/autoStopGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip android:id="@+id/as0" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Off" />
            <com.google.android.material.chip.Chip android:id="@+id/as30" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="30s" />
            <com.google.android.material.chip.Chip android:id="@+id/as60" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="60s" />
            <com.google.android.material.chip.Chip android:id="@+id/as90" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="90s" />
            <com.google.android.material.chip.Chip android:id="@+id/as120" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="120s" />
            <com.google.android.material.chip.Chip android:id="@+id/as150" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="150s" />
            <com.google.android.material.chip.Chip android:id="@+id/as180" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="180s" />
        </com.google.android.material.chip.ChipGroup>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/smallFilesSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Smaller files (H.265). Turn off only if an old player cannot open your videos" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/mirrorSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Mirror the front camera" />

        <!-- Cut-out -->
        <TextView style="@style/SheetSection" android:text="Cut-out" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/modelGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/mHq"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Best edges" />

            <com.google.android.material.chip.Chip
                android:id="@+id/mFast"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fast (older phones)" />
        </com.google.android.material.chip.ChipGroup>

        <TextView style="@style/SheetLabel" android:text="Edge softness" />

        <com.google.android.material.slider.Slider
            android:id="@+id/softnessSlider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="0"
            android:valueTo="1" />

        <!-- Music -->
        <TextView style="@style/SheetSection" android:text="Background music" />

        <TextView
            android:id="@+id/musicName"
            style="@style/SheetLabel"
            android:text="No music chosen" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/musicPickBtn"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Choose music" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/musicRemoveBtn"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Remove" />
        </LinearLayout>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/musicSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Add the music to recordings" />

        <TextView style="@style/SheetLabel" android:text="Music volume" />

        <com.google.android.material.slider.Slider
            android:id="@+id/musicVolume"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="0"
            android:valueTo="100" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/musicDuckSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Make the music quieter while I speak" />

        <TextView
            style="@style/SheetLabel"
            android:text="The music is mixed straight into the video, so you won't hear it while recording. It loops if your video is longer than the song." />

        <!-- Brand -->
        <TextView style="@style/SheetSection" android:text="Brand" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Your name">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/brandName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPersonName|textCapWords"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Role or company (optional)">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/brandRole"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapWords"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView style="@style/SheetLabel" android:text="Brand colour" />

        <LinearLayout
            android:id="@+id/brandColors"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/nameTitleSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Show my name on the video (name title)" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/introSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Intro card at the start of each recording" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:hint="Intro title (optional, else your name)">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/introTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapSentences"
                android:maxLines="2" />
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/exportKitBtn"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Share brand kit" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/importKitBtn"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="Import kit" />
        </LinearLayout>

        <TextView
            style="@style/SheetLabel"
            android:text="A brand kit holds your logo, backdrops, name title and colour. Share it with your team so everyone records with the same look." />

        <!-- Sharing -->
        <TextView style="@style/SheetSection" android:text="Sharing" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/autoUploadSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Upload to Google Drive after each recording" />

        <!-- Tips -->
        <TextView style="@style/SheetSection" android:text="Tips" />

        <TextView
            style="@style/SheetLabel"
            android:lineSpacingMultiplier="1.25"
            android:text="• Volume buttons or a Bluetooth selfie remote start and stop recording.\n• Hands-free (side toolbar): say “start” to record and “stop” to finish.\n• Share text from Docs, Notes or WhatsApp to BackdropCam to make a teleprompter script.\n• Logo (side toolbar): add your logo, then drag, pinch and twist it into place. Each backdrop remembers its own logo position." />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
