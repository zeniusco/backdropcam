<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView style="@style/SheetTitle" android:text="Settings" />

        <TextView style="@style/SheetLabel" android:text="Video quality" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/qualityGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/qMax"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Highest (up to 4K)" />

            <com.google.android.material.chip.Chip
                android:id="@+id/q1080"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1080p" />

            <com.google.android.material.chip.Chip
                android:id="@+id/q720"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="720p" />
        </com.google.android.material.chip.ChipGroup>

        <TextView style="@style/SheetLabel" android:text="Cut-out quality" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/modelGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/mHq"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Best (recommended)" />

            <com.google.android.material.chip.Chip
                android:id="@+id/mFast"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fast (older phones)" />
        </com.google.android.material.chip.ChipGroup>

        <TextView style="@style/SheetLabel" android:text="Edge softness" />

        <com.google.android.material.slider.Slider
            android:id="@+id/softnessSlider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="0"
            android:valueTo="1" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/mirrorSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Mirror front camera (like a mirror)" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/wideSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Start zoomed out (widest view)" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/handsFreeSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Hands-free: voice guide, say &quot;start&quot;, clap twice to stop" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/autoUploadSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Auto-upload to Google Drive after recording" />

        <TextView
            style="@style/SheetLabel"
            android:text="Tip: the phone's volume buttons, or a Bluetooth selfie remote, start and stop recording. Useful when the phone is on a tripod." />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
