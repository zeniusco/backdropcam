<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView style="@style/SheetTitle" android:text="Microphone" />

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/micSwitch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Record sound" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Mic volume"
            android:textColor="#B3FFFFFF" />

        <TextView
            android:id="@+id/gainValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="100%"
            android:textColor="@android:color/white"
            android:textStyle="bold" />
    </LinearLayout>

    <com.google.android.material.slider.Slider
        android:id="@+id/gainSlider"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:stepSize="5"
        android:value="100"
        android:valueFrom="0"
        android:valueTo="200" />

    <TextView
        style="@style/SheetLabel"
        android:text="Live level (speak to test)" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/levelMeter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:max="100"
        app:indicatorColor="#4CAF50"
        app:trackThickness="10dp" />

    <TextView
        style="@style/SheetLabel"
        android:text="100% is the phone's normal level. Raise it if your voice is quiet in the video, lower it if the bar hits the end while you talk." />
</LinearLayout>
